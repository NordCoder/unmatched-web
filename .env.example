POSTGRES_DB=unmatched
POSTGRES_USER=unmatched
POSTGRES_PASSWORD=unmatched-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://unmatched:unmatched-local-only@localhost:5432/unmatched?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=1
POSTGRES_CONNECT_TIMEOUT=10s
POSTGRES_SEARCH_PATH=

# Optional: use an existing isolated PostgreSQL database for integration tests.
# Without this value, tests start postgres:17-alpine through Docker.
CORE_TEST_DATABASE_URL=
